pyproject.toml:
[tool.briefcase]
project_name = "Wallhaven Downloader"
bundle = "com.wallhaven"
version = "1.1.0"
url = "https://github.com/XQGIN/wallhaven_downloader"
license.file = "LICENSE"
author = "XQGIN"
author_email = ""

[tool.briefcase.app.wallhaven_downloader]
formal_name = "Wallhaven壁纸下载器"
description = "一个基于PyQt5的Wallhaven壁纸批量下载工具"
long_description = """一个基于PyQt5的Wallhaven壁纸批量下载工具，支持多种下载方式和自定义设置。

功能特性：
- 多种下载方式：支持下载最新壁纸、从指定类别下载、通过关键词搜索下载
- 高性能下载：支持多线程并发下载，提高下载效率
- 美观界面：采用液态玻璃效果设计，支持浅色/深色/自动主题切换
- 图片预览：实时预览已下载的图片，支持分页显示
- 智能管理：自动检测重复文件、支持断点续传、内存优化
"""
sources = ['wallhaven_downloader']
icon = "icon/logo"
splash = "icon/logo"

# 添加额外资源文件
resources = [
    'locales',
    'icon',
]

test_sources = ['tests']

requires = [
    'PyQt5==5.15.9',
    'requests==2.31.0',
    'Pillow>=10.0.0,<13.0.0',
    'psutil==5.9.5',
    'urllib3==2.0.4',
    'loguru>=0.7.0',
    'python-dotenv>=1.0.0',
]

# Windows配置
[tool.briefcase.app.wallhaven_downloader.windows]
requires = [
    'PyQt5==5.15.9',
    'requests==2.31.0',
    'Pillow>=10.0.0,<13.0.0',
    'psutil==5.9.5',
    'urllib3==2.0.4',
    'loguru>=0.7.0',
    'python-dotenv>=1.0.0',
]

# macOS配置
[tool.briefcase.app.wallhaven_downloader.macOS]
requires = [
    'PyQt5==5.15.9',
    'requests==2.31.0',
    'Pillow>=10.0.0,<13.0.0',
    'psutil==5.9.5',
    'urllib3==2.0.4',
    'loguru>=0.7.0',
    'python-dotenv>=1.0.0',
]

# Linux配置
[tool.briefcase.app.wallhaven_downloader.linux]
requires = [
    'PyQt5==5.15.9',
    'requests==2.31.0',
    'Pillow>=10.0.0,<13.0.0',
    'psutil==5.9.5',
    'urllib3==2.0.4',
    'loguru>=0.7.0',
    'python-dotenv>=1.0.0',
]
system_requires = [
    'libgl1-mesa-glx',
    'libxkbcommon-x11-0',
    'libxcb-icccm4',
    'libxcb-image0',
    'libxcb-keysyms1',
    'libxcb-randr0',
    'libxcb-render-util0',
    'libxcb-xinerama0',
    'libxcb-xfixes0',
]

[build-system]
requires = ["briefcase"]

